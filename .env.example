# Copy to .env and fill in values. Never commit real secrets.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/property_portfolio?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Application-level encryption for sensitive fields / OAuth tokens (64 hex chars = 32 bytes)
ENCRYPTION_KEY="replace-with-64-hex-characters"

# File storage: local | s3
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_LOCAL_DIR="./storage/uploads"
# S3-compatible (production)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# App
NEXT_PUBLIC_APP_NAME="Pachtfolio"
APP_ENV="development"

# Rate limiting
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_MS="900000"

# Optional monitoring
SENTRY_DSN=""

# Quicken integrates via file import (OFX/QFX/QIF/CSV) — no OAuth client required.
# Legacy QuickBooks env vars are unused and can be removed.
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_REDIRECT_URI=""
# QUICKBOOKS_ENVIRONMENT="sandbox"

# Gmail OAuth — leave empty to hide Connect until configured (demo mailbox still works in non-prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to ${AUTH_URL}/api/integrations/gmail/callback when empty
GOOGLE_REDIRECT_URI=""

# Microsoft OAuth — leave empty until Azure app is ready
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Defaults to ${AUTH_URL}/api/integrations/microsoft/callback when empty
MICROSOFT_REDIRECT_URI=""
MICROSOFT_TENANT_ID="common"
